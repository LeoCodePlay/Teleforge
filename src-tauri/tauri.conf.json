{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Teleforge",
  "version": "0.1.5",
  "identifier": "com.teleforge.desktop",
  "mainBinaryName": "teleforge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build && node scripts/build.mjs",
    "frontendDist": "loading"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Teleforge - 远程 AI 编程工具",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": false,
        "transparent": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/": ""
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "category": "DeveloperTool",
    "shortDescription": "SSH 远程 AI 编程工具",
    "longDescription": "保持 SSH 连接、选择远程工作区、AI Agent 在远程服务器上读写文件与执行命令",
    "copyright": "GPL-3.0"
  }
}
