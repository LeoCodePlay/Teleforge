node_modules/

# 构建产物
web/dist/
web/dist-preview/

# 日志与调试
*.log
server-trace.log*

# 本地工具目录(不入库)
.superpowers/
.playwright-cli/
docs/superpowers/
dbg2.mjs
_diag_*.cjs
desktop/.staging/

