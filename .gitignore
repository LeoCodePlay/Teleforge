# 依赖
node_modules/

# 构建产物
web/dist/
web/dist-preview/

# 官网(独立 SSR 站点,不参与桌面端打包)的构建缓存与产物
website/.next/
website/out/
website/tsconfig.tsbuildinfo

# 日志与调试
*.log
server-trace.log*
# tsc 输出转储(排查类型错误时的临时快照,不入库;磁盘上保留)
_tsc_*.txt
# 根目录其它临时转储与一次性诊断脚本(_a.txt / _commit_msg.txt / _check-b.cjs 之类)
/_*.txt
/_*.cjs

# 本地工具目录(不入库)
.superpowers/
.playwright-cli/
docs/superpowers/
dbg2.mjs
_diag_*.cjs
_repro/
desktop/.staging/

# 编辑器
.vscode/
.idea/
.DS_Store

# Python 编译产物(server/skills/image-toolkit 的 imgtool.py)
__pycache__/
*.pyc

# 运行时数据(会话历史持久化,含对话工具结果与连接配置缓存,不入库)
# 注意:必须根锚定(/data/),否则会误伤 web/src/data/ 下的源码(提供商模板)
/data/
server/data/
.gstack/

# 生图工具的默认输出目录(运行时产物,不入库)
generated-images/

# Playwright 探针截图(output/ 是构建/调试产物目录,不入库)
output/playwright/

# logo 制作产物与扩展打包产物(生成脚本、中间 PNG、旧图标备份、发布用 zip;一律不入库)
# 成品图标已落到 src-tauri/icons/ 与 web/public/logo*.png,设计源在 docs/logo/
output/
