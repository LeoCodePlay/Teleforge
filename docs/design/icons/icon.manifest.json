{
  "name": "teleforge-workspace-nav-icons",
  "version": "1.1.0",
  "project": "Teleforge(远程 SSH AI 编程工具)",
  "sourceOfTruth": "web/src/components/icons/icons.tsx",
  "preview": "docs/design/icons/icon-preview.html",
  "sprite": "docs/design/icons/icon.sprite.svg",
  "spec": "docs/design/icons/icon.spec.md",
  "recommendedTech": "svg",
  "recommendedTechReason": [
    "全部是 12~20px 的界面图标:矢量缩放无损、随 currentColor 换主题、单枚约 0.3KB 且可被 gzip 复用",
    "需要随标签/行文字换色(激活态、锁定态、远程/本地语义色),CSS 颜色与 SVG 同源最省事",
    "无需像素处理、无需大量动态图元:不构成 Canvas 触发条件(见 canvas 字段)"
  ],
  "canvas": {
    "needed": false,
    "triggerConditions": [
      "同一画布上成千上万图元(如大规模连线图/拓扑图)",
      "需要逐像素读写(滤镜、抠像、导出位图)",
      "需要每帧重绘的复杂动效(粒子、波形)"
    ],
    "reuseHint": "如后续要做 Canvas 版,可直接复用这里的 path d 常量,以 Path2D(d) 绘制;颜色用 ctx.strokeStyle = getComputedStyle(el).color 取主题色",
    "demo": null
  },
  "style": {
    "grid": 16,
    "viewBox": "0 0 16 16",
    "strokeWidth": 1.6,
    "stroke": "currentColor",
    "fill": "none(两处实心是表意需要:IconAiChat16 的星芒、IconTheme16 的对比半圆)",
    "strokeLinecap": "round",
    "strokeLinejoin": "round",
    "cornerRadius": "1.4~2.2(按形状在网格上取整)",
    "naming": "Icon<PascalName><Grid>(如 IconCloud16)",
    "api": "{ size?: number; className?: string } —— 尺寸靠 size 显式给(不靠 font-size),颜色靠所在行文字色",
    "optics": "内容 bbox 统一居中于 8,8;单侧留白 1.2~2.8 网格单位(见 preview 中各图标的实测边距)"
  },
  "semantics": {
    "pairing": "远程 vs 本地各用一个完整形状,不做「文件夹 + 小角标」的叠图(≤14px 会糊)",
    "remoteWorkspace": "云 = 远端(AI 通过 SSH 在远端读写)",
    "localWorkspace": "文件夹 = 本机目录",
    "remoteWholeMachine": "机架 = 不绑目录,边界=整台服务器",
    "localWholeMachine": "显示器 = 不绑目录,边界=整台电脑"
  },
